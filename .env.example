# Copie pra .env.test e preencha com os valores que `supabase start` imprime
# no terminal (ou `supabase status`, se já estiver rodando).

SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# A SERVICE_ROLE_KEY é necessária só pro script de seed de usuários e pro
# client "admin" usado nos testes pra preparar dado de comparação — NUNCA
# deve ser usada em código de frontend/cliente.
